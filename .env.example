# ==============================================================================
# 생활 민원 길잡이 (Civil Defense) 환경 변수 템플릿
# ==============================================================================
# 이 파일을 복사하여 .env 파일을 생성하세요: cp .env.example .env
# 실제 비밀번호, API 키 등 민감 정보는 절대 저장소에 커밋하지 마세요.

# ------------------------------------------------------------------------------
# 1. Docker Compose 실행 프로필
# ------------------------------------------------------------------------------
# - COMPOSE_PROFILES=local : PostgreSQL, Redis 컨테이너를 로컬 컴퓨터에서 함께 실행
# - COMPOSE_PROFILES=      : 앱 서버 배포 시 빈 값으로 두고 원격 데이터 서버 주소 사용
COMPOSE_PROFILES=local

# ------------------------------------------------------------------------------
# 2. 데이터베이스 및 캐시 설정 (PostgreSQL & Redis)
# ------------------------------------------------------------------------------
# [Compose 내부 네트워크]
# Compose 내부에서는 컨테이너 이름(postgres, redis)이 도메인명으로 사용됩니다.
# docker-compose.yml의 기본값으로 자동 조립되므로 별도 지정하지 않아도 됩니다.
#
# [백엔드 단독 로컬 실행 (uvicorn)]
# 백엔드를 호스트 머신에서 직접 실행할 때는 localhost 포트로 접속합니다:
# DATABASE_URL=postgresql://minwon:minwon_local@localhost:5432/minwon
# REDIS_URL=redis://localhost:6379/0
#
# [원격 데이터 서버 연동 (앱 서버 배포)]
# DATABASE_URL=postgresql://minwon:<비밀번호>@<데이터 서버 IP>:5432/minwon
# REDIS_URL=redis://:<비밀번호>@<데이터 서버 IP>:6379/0

POSTGRES_DB=minwon
POSTGRES_USER=minwon
POSTGRES_PASSWORD=minwon_local
POSTGRES_PORT=5432
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. 서비스 포트 및 바인딩 설정
# ------------------------------------------------------------------------------
FRONTEND_PORT=8501
# FRONTEND_BIND: 로컬에서는 127.0.0.1, 외부 접속 허용 앱 서버에서는 0.0.0.0
FRONTEND_BIND=127.0.0.1
# 관제 basic auth: ADMIN_GATE=on일 때 ADMIN_PASS=<비밀번호> 필수
ADMIN_GATE=off
ADMIN_USER=admin
ADMIN_PASS=
BACKEND_PORT=8000
CLASSIFIER_PORT=8010
LOCATOR_PORT=8020
VERIFIER_PORT=8030
WRITER_PORT=8040
MAILER_PORT=8060
CHAOS_PORT=8050
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# ------------------------------------------------------------------------------
# 4. 에이전트 서비스 URL (백엔드 단독 로컬 실행 시 설정)
# ------------------------------------------------------------------------------
# Compose 내부에서는 http://<서비스명>:8000 형식으로 자동 설정됩니다.
# 백엔드를 IDE/로컬에서 단독 실행할 때만 아래 호스트 포트 주소를 사용하세요:
# CLASSIFIER_URL=http://localhost:8010
# LOCATOR_URL=http://localhost:8020
# VERIFIER_URL=http://localhost:8030
# WRITER_URL=http://localhost:8040
# MAILER_URL=http://localhost:8060
# CHAOS_URL=http://localhost:8050

# ------------------------------------------------------------------------------
# 5. OpenAI API 및 LLM 모델 설정
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_FALLBACK_MODEL=gpt-5.4-mini

# 장소의 실제 지역을 확인하는 카카오 로컬 API REST 키입니다.
# 비워 두거나 조회에 실패하면 번들 역 데이터로 확인합니다.
KAKAO_REST_KEY=

# ------------------------------------------------------------------------------
# 6. 가상 발송 (Mailer) 및 우체국 (Mailpit) 설정
# ------------------------------------------------------------------------------
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# MAIL_SENDER=minwon-guide@minwon.example
# MAIL_CITIZEN=citizen@minwon.example
# 시연용 실제 수신함 1곳으로 신고·회신 복사본을 보냅니다.
# 지메일이면 앱 비밀번호를 사용하세요. 비우면 꺼집니다.
# 자격증명은 로컬 .env에만 넣고 커밋하지 마세요.
MAIL_RELAY_HOST=
MAIL_RELAY_PORT=
MAIL_RELAY_USER=
MAIL_RELAY_PASSWORD=
MAIL_RELAY_TO=

# ------------------------------------------------------------------------------
# 7. 카오스 및 인프라 장애 시험 설정
# ------------------------------------------------------------------------------
# scripts/chaos_infra.sh의 DB 끊김 시험용 대상 호스트 (IPv4 지원)
# 로컬 컨테이너 시험 시 빈칸 또는 생략, 원격 데이터 서버 시험 시 해당 IP 입력
# DATA_HOST=<데이터 서버 IP>
# 장애 스크립트는 기본 .env를 읽음. 별도 격리 환경: CHAOS_ENV_FILE=.venv/qa.env bash scripts/chaos_infra.sh classifier 5
