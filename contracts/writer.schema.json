{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minwon.local/contracts/writer.schema.json",
  "type": "object",
  "properties": {
    "evidence": {"$ref": "common.schema.json#/$defs/evidence"},
    "recovery": {
      "type": "object", "additionalProperties": false,
      "required": ["attempts", "recovered_by", "elapsed_ms", "started_at"],
      "properties": {
        "attempts": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["model", "error_type", "elapsed_ms", "started_at"],
            "properties": {
              "evidence": {"$ref": "common.schema.json#/$defs/evidence"},
              "model": {"type": "string", "minLength": 1},
              "error_type": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
              "elapsed_ms": {"type": "integer", "minimum": 0},
              "started_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|\\+00:00)$"}
            }
          }
        },
        "recovered_by": {"type": "string", "minLength": 1},
        "elapsed_ms": {"type": "integer", "minimum": 0},
        "started_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|\\+00:00)$"}
      }
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "fill_in": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "placeholder": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "placeholder"
        ],
        "additionalProperties": false
      }
    },
    "removed_pii": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "body",
    "fill_in",
    "removed_pii"
  ],
  "additionalProperties": false
}
