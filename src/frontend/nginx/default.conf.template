server {
  listen 80;
  root /usr/share/nginx/html;
  # https 프록시 뒤에서도 /admin → /admin/ 이동이 http로 바뀌지 않게 상대 주소로 보낸다.
  absolute_redirect off;
  # backend 컨테이너가 다시 뜨면 IP가 바뀌므로 매 요청마다 도커 내부 DNS로 다시 찾는다.
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $backend http://backend:8000;
  set $mailpit http://mailpit:8025;
  location = /health { default_type application/json; return 200 '{"status":"ok","service":"frontend"}'; }
  location = /admin { return 301 /admin/; }
  location /admin/ { include /etc/nginx/admin_gate.conf; try_files $uri /admin.html; }
  location = /admin.html { include /etc/nginx/admin_gate.conf; }
  location /api/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $backend;
  }
  location /mailbox/ {
    limit_except GET { deny all; }
    # Mailpit은 MP_WEBROOT=/mailbox 로 뜨므로 접두사를 그대로 넘긴다(접두사를 떼면 화면 자산을 루트에서 찾아 흰 화면)
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_pass $mailpit;
  }
  location / { try_files $uri $uri/ /index.html; }
}
