{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "ES2022.Intl",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@contracts/*": [
        "../../contracts/*"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts"
  ]
}
